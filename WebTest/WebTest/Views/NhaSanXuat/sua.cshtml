@model WebTest.Models.Nhasanxuat
@{ ViewData["Title"] = "Sửa nhà sản xuất"; }
<h2>Sửa nhà sản xuất</h2>
<form asp-action="sua" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Mansx" type="hidden" /><p><strong>Mã nhà sản xuất:</strong> @Model.Mansx</p>
<div class="mb-3"><label asp-for="Tennsx" class="form-label"></label>
<input asp-for="Tennsx" class="form-control" />
<span asp-validation-for="Tennsx" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Diachi" class="form-label"></label>
<input asp-for="Diachi" class="form-control" />
<span asp-validation-for="Diachi" class="text-danger"></span></div>
<button class="btn btn-primary" type="submit">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
}

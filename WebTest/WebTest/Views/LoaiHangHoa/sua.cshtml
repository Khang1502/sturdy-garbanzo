@model WebTest.Models.Loaihanghoa
@{ ViewData["Title"] = "Sửa loại hàng hóa"; }
<h2>Sửa loại hàng hóa</h2>
<form asp-action="sua" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Maloai" type="hidden" /><p><strong>Mã loại hàng hóa:</strong> @Model.Maloai</p>
<div class="mb-3"><label asp-for="Tenloai" class="form-label"></label>
<input asp-for="Tenloai" class="form-control" />
<span asp-validation-for="Tenloai" class="text-danger"></span></div>
<button class="btn btn-primary" type="submit">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
}

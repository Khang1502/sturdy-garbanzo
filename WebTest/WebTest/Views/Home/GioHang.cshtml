@model WebTest.Models.CartModel
@using Microsoft.AspNetCore.Http
@{ ViewData["Title"] = "Giỏ hàng"; }
<h2>Giỏ hàng</h2><div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Lines.Count == 0) { <p>Giỏ hàng đang trống.</p> } else {
<div class="table-responsive"><table class="table"><thead><tr><th>Mã hàng</th><th>Tên hàng</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>
@foreach (var line in Model.Lines) {
<tr><td>@line.Hang.Mahang</td><td>@line.Hang.Tenhang</td><td>@line.Hang.Dongia?.ToString("N0")</td><td>@line.Soluong</td><td>@line.ThanhTien.ToString("N0")</td><td>
<form asp-action="XoaKhoiGio" method="post"><input type="hidden" name="id" value="@line.Hang.Mahang" /><button class="btn btn-outline-danger btn-sm">Xóa</button></form></td></tr>
}
</tbody></table></div><p><strong>Tổng tiền: @Model.TongTien.ToString("N0") đ</strong></p>
@if (Context.Session.GetString("Khachhang") == null) {
<p><a asp-controller="KhachHang" asp-action="indexDangNhap">Đăng nhập</a> để lập đơn đặt hàng.</p>
} else {
<form asp-action="LapDonDatHang" method="post">
<div class="mb-3"><label asp-for="Diachigh" class="form-label"></label><input asp-for="Diachigh" class="form-control" /><span asp-validation-for="Diachigh"></span></div>
<div class="mb-3"><label asp-for="Ngaygh" class="form-label"></label><input asp-for="Ngaygh" type="date" class="form-control" /><span asp-validation-for="Ngaygh"></span></div>
<button class="btn btn-primary">Lập đơn đặt hàng</button></form>
}
}
<a asp-action="Index" class="btn btn-outline-secondary mt-3">Trở về</a>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

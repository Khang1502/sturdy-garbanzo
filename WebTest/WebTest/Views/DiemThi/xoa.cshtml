@model WebTest.Models.DiemThi
<h2>Xóa Điểm thi</h2><div asp-validation-summary="All" class="text-danger"></div><p>Mã học viên: @Model.Mshv</p><p>Mã môn học: @Model.Msmh</p><p>Điểm: @Model.Diem</p>@if (ViewBag.CoLienQuan == true) { <div class="alert alert-warning">Không thể xóa vì có dữ liệu liên quan.</div> } else {
<form asp-action="xoa" method="post"><input type="hidden" name="id" value="@Model.Mshv" /><input type="hidden" name="mon" value="@Model.Msmh" /><button class="btn btn-danger">Xác nhận xóa</button></form> }<a asp-action="Index">Quay lại</a>

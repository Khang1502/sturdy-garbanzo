@model IEnumerable<WebTest.Models.LyLich>
<h2>Quản lý Lý lịch học viên</h2>
<nav class="mb-3 d-flex gap-2"><a asp-controller="LyLich" asp-action="Index">Lý lịch học viên</a><a asp-controller="Lop" asp-action="Index">Lớp</a><a asp-controller="MonHoc" asp-action="Index">Môn học</a><a asp-controller="DiemThi" asp-action="Index">Điểm thi</a></nav>
<p><a asp-action="them" class="btn btn-primary">Thêm mới</a></p><div class="table-responsive"><table class="table"><thead><tr><th>Mã học viên</th><th>Tên học viên</th><th>Ngày sinh</th><th>Phái</th><th>Lớp</th><th>Tác vụ</th></tr></thead><tbody>
@foreach(var item in Model) { <tr>
<td>@item.Mshv</td><td>@item.Tenhv</td><td>@item.Ngaysinh?.ToString("dd/MM/yyyy")</td><td>@(item.Phai == true ? "Nam" : "Nữ")</td><td>@item.Malop</td><td><a asp-action="sua" asp-route-id="@item.Mshv">Sửa</a> | <a asp-action="xoa" asp-route-id="@item.Mshv">Xóa</a></td></tr> }
</tbody></table></div>

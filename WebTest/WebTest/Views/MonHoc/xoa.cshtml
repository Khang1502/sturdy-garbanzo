@model WebTest.Models.MonHoc
<h2>Xóa Môn học</h2><div asp-validation-summary="All" class="text-danger"></div><p>Mã môn học: @Model.Msmh</p><p>Tên môn học: @Model.Tenmh</p><p>Số tiết: @Model.Sotiet</p>@if (ViewBag.CoLienQuan == true) { <div class="alert alert-warning">Không thể xóa vì có dữ liệu liên quan.</div> } else {
<form asp-action="xoa" method="post"><input type="hidden" name="id" value="@Model.Msmh" /><button class="btn btn-danger">Xác nhận xóa</button></form> }<a asp-action="Index">Quay lại</a>

@model IEnumerable<WebTest.Models.Khachhang>
@{ ViewData["Title"] = "Quản lý khách hàng"; }
<h2>Quản lý khách hàng</h2>
<p><a asp-action="them" class="btn btn-primary">Thêm mới</a></p>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Mã khách hàng</th><th>Tên khách hàng</th><th>Năm sinh</th><th>Phái</th><th>Điện thoại</th><th>Địa chỉ</th><th>Tác vụ</th></tr></thead><tbody>
@foreach (var item in Model) { <tr>
<td>@item.Makh</td>
<td>@item.Tenkh</td>
<td>@item.Namsinh</td>
<td>@(item.Phai == true ? "Nam" : item.Phai == false ? "Nữ" : "")</td>
<td>@item.Dienthoai</td>
<td>@item.Diachi</td>
<td><a asp-action="sua" asp-route-id="@item.Makh">Sửa</a> | <a asp-action="xoa" asp-route-id="@item.Makh">Xóa</a></td></tr> }
</tbody></table></div>
@if (!Model.Any()) { <p>Chưa có dữ liệu.</p> }

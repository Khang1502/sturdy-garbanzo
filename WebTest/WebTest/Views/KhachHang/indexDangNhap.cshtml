@model WebTest.Models.LoginModel
@{ ViewData["Title"] = "Đăng nhập"; }
<h2>Đăng nhập hệ thống</h2>
<form asp-action="dangnhap" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Makh" class="form-label"></label><input asp-for="Makh" class="form-control" autocomplete="username" /><span asp-validation-for="Makh"></span></div>
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password"></span></div>
<button class="btn btn-primary">Đăng nhập</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

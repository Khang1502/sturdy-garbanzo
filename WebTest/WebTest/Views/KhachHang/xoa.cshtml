@model WebTest.Models.Khachhang
<h2>Xóa khách hàng</h2>
<div asp-validation-summary="All" class="text-danger"></div>
<p><strong>Mã khách hàng:</strong> @Model.Makh</p>
<p><strong>Tên khách hàng:</strong> @Model.Tenkh</p>
<p><strong>Năm sinh:</strong> @Model.Namsinh</p>
<p><strong>Phái:</strong> @Model.Phai</p>
<p><strong>Điện thoại:</strong> @Model.Dienthoai</p>
<p><strong>Địa chỉ:</strong> @Model.Diachi</p>
@if (ViewBag.CoLienQuan == true) {
<div class="alert alert-warning">Không thể xóa: dữ liệu đang được sử dụng ở bảng liên quan.</div>
} else {
<form asp-action="xoa" method="post"><input type="hidden" name="id" value="@Model.Makh" />
<p>Bạn có chắc muốn xóa bản ghi này?</p><button class="btn btn-danger">Xác nhận xóa</button></form>
}
<a asp-action="Index" class="btn btn-outline-secondary mt-2">Quay lại</a>
